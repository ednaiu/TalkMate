<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <ImageView
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/art_auth" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/brand_name"
            android:textColor="@color/subtitle"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_auth_card"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/AuthTitle"
                android:text="@string/create_account" />

            <TextView
                android:id="@+id/tvHello"
                style="@style/AuthSubtitle"
                android:text="@string/signup_subtitle" />

            <TextView style="@style/AuthLabel" android:labelFor="@+id/etName" android:text="@string/label_name" />

            <EditText
                android:id="@+id/etName"
                style="@style/AuthField"
                android:hint="@string/hint_name_ask"
                android:autofillHints="name"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords" />

            <TextView style="@style/AuthLabel" android:labelFor="@+id/etEmail" android:text="@string/label_email" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/AuthField"
                android:hint="@string/hint_email_example"
                android:autofillHints="emailAddress"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress" />

            <TextView style="@style/AuthLabel" android:labelFor="@+id/etPassword" android:text="@string/label_password" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/AuthField"
                    android:hint="@string/hint_password_new"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:paddingEnd="52dp" />

                <ImageButton
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/show_password"
                    android:src="@drawable/ic_eye_off" />
            </FrameLayout>

            <TextView style="@style/AuthLabel" android:labelFor="@+id/etPhone" android:text="@string/label_phone" />

            <EditText
                android:id="@+id/etPhone"
                style="@style/AuthField"
                android:hint="@string/hint_phone_example"
                android:autofillHints="phone"
                android:imeOptions="actionNext"
                android:inputType="phone" />

            <TextView style="@style/AuthLabel" android:labelFor="@+id/etBirthDate" android:text="@string/label_birth" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etBirthDate"
                    style="@style/AuthField"
                    android:hint="@string/hint_birth_format"
                    android:importantForAutofill="no"
                    android:imeOptions="actionDone"
                    android:inputType="date"
                    android:paddingEnd="52dp" />

                <ImageButton
                    android:id="@+id/btnPickDate"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/pick_date"
                    android:src="@drawable/ic_calendar" />
            </FrameLayout>

            <TextView style="@style/AuthLabel" android:layout_marginBottom="0dp" android:text="@string/label_gender" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="40dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnFemale"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/female"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_female"
                        app:tint="@color/gender_tint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/gender_female"
                        android:textColor="@color/field_label"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/btnMale"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/male"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_male"
                        app:tint="@color/gender_tint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/gender_male"
                        android:textColor="@color/field_label"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvError"
                style="@style/FormError"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="0dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                style="@style/Button.Filled"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/create_account"
                android:textSize="18sp"
                app:backgroundTint="@color/blue_strong"
                app:cornerRadius="32dp" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/loading"
                android:indeterminateTint="@color/blue_strong"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/have_account"
                android:textColor="@color/subtitle"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvLogin"
                style="@style/AuthLink"
                android:paddingStart="6dp"
                android:paddingEnd="12dp"
                android:text="@string/log_in" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
