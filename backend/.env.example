# Скопируйте в .env и поправьте значения. run.sh подхватит файл сам.
DATABASE_URL=mysql+pymysql://talkmate:talkmate@127.0.0.1:3307/talkmate?charset=utf8mb4
SECRET_KEY=замените-на-длинную-случайную-строку
PORT=5050

# Сервер анализа речи. run.sh поднимает его сам на 127.0.0.1:5051.
# Если он стоит на другой машине, укажите адрес и общий токен.
#ANALYSIS_URL=http://10.0.0.5:5051
#ANALYSIS_TOKEN=

# Распознавание речи работает локально, без внешних сервисов.
# auto: модель ASR_MODEL через onnx-asr, при неудаче запасная модель Vosk из backend/models/
RECOGNIZER=auto
ASR_MODEL=gigaam-v3-e2e-ctc

# Эмоции: talkmate (кодировщик Aniemore и дообученная голова) | aniemore (исходная модель) | off
EMOTION_BACKEND=talkmate
EMOTION_MODEL=Aniemore/wavlm-emotion-russian-resd

# Основная мысль выступления: rut5 (локальная модель пересказа, около 900 МБ) | extractive (цитата из речи)
MAIN_IDEA_BACKEND=rut5

ADMIN_EMAIL=admin@talkmate.local
ADMIN_PASSWORD=admin12345

# Почта для писем с кодом восстановления пароля.
# Пока SMTP_HOST пуст, письмо не уходит, а код пишется в журнал сервера (годится только для разработки).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
